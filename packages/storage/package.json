{
  "name": "@viccoboard/storage",
  "version": "0.1.0",
  "description": "Encrypted local storage implementation for ViccoBoard",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "storage",
    "sqlite",
    "encryption",
    "database"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@viccoboard/core": "*",
    "bcryptjs": "^3.0.3",
    "crypto-js": "^4.2.0",
    "sql.js": "^1.16.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.2.0",
    "fake-indexeddb": "^6.2.8",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  }
}
